# -------------------------------------------------------------------
# Wise Guys Windows — environment variables
# Copy to .env.local and fill in. Everything is optional for local dev:
# the quote flow still works (and shows prices) without these set.
# -------------------------------------------------------------------

# --- SendGrid (email notifications) ---
SENDGRID_API_KEY=
# Verified sender address in SendGrid (Single Sender or domain auth)
SENDGRID_FROM_EMAIL=mshapovalov7@gmail.com
# Where new quote notifications are sent
QUOTE_NOTIFICATION_EMAIL=mshapovalov7@gmail.com

# --- Google Places (address autocomplete) ---
# Optional. Without it, the address field is a plain text input.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
